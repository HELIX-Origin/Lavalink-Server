# Lavalink Connection & Security
# ------------------------------------------------------------------
# The server uses a split configuration: internal (node binding + WS) and
# public (bot-facing, Cloudflare tunnel friendly). The public port is always
# masked — bots should connect to LAVA_PUBLIC_URL and append the endpoint
# (e.g. /v4/websocket), NOT to a visible port number.

LAVA_INTERNAL_URL="0.0.0.0:2333"                              # Internal bind host:port for the Lavalink node itself.
LAVA_PUBLIC_URL="https://lavalink.example.com"                # Public URL bots use to reach this server (Cloudflare/Lego tunnel friendly). Scheme is required. Defaults to LAVA_INTERNAL_URL when empty.
LAVA_INTERNAL_WS_URI="ws://0.0.0.0:2333/v4/websocket"         # Internal WebSocket the embedded Lavalink node listens on.
LAVA_PUBLIC_WS_URI="ws://lavalink.example.com/v4/websocket"   # Public WebSocket URI shown to bots (port is masked at the public URL). Defaults to the internal WS URI when no public URL is set.
LAVA_PASS="youshallnotpass"                                   # Lavalink authentication password (shared authorization header).
LAVA_CIPHER_URL="https://cipher.kikkia.dev/"                 # Remote cipher endpoint for YouTube signature deciphering.
LAVA_CIPHER_PASSWORD=""                                      # Optional password for self-hosted cipher. Automatically provisioned by the cipher.kikkia.dev remote cipher server.

# Reverse Proxy (optional)
# Set REVERSE_PROXY_ENABLED=true when the public URL is served through a
# Cloudflare tunnel or a reverse proxy that masks the public port. The
# dashboard then labels the public port as masked and shows the proxy type.
REVERSE_PROXY_ENABLED="false"                                # Toggles public-port masking in the dashboard (false = direct public hosting).
REVERSE_PROXY_TYPE="cloudflare"                              # Label for the masking indicator: cloudflare | nginx | caddy | custom (used only when enabled).

# YouTube OAuth
YOUTUBE_CLIENT_ID=""                                         # REQUIRED - YouTube OAuth Client ID (app type: "TVs and Limited Input devices").
YOUTUBE_CLIENT_SECRET=""                                     # REQUIRED - YouTube OAuth Client Secret for the Client ID above.
YOUTUBE_REFRESH_TOKEN=""                                     # Optional - Pre-authorized refresh token (auto-saved after device flow).

# Spotify
SPOTIFY_CLIENT_ID=""                                         # REQUIRED - Spotify Developer App Client ID for use with Spotify integration.
SPOTIFY_CLIENT_SECRET=""                                     # REQUIRED - Spotify Developer App Client Secret for use with Spotify integration.

# Genius (for LavaLyrics plugin)
GENIUS_ACCESS_TOKEN=""                                       # REQUIRED - Genius API Access Token for lyrics for use with LavaLyrics integration.

# Database
DB_PATH="./data/database.db"                                  # SQLite database file path
DB_URI="sqlite://./data/database.db"                          # SQLite database URI

# Environment
NODE_ENV="production"                                        # Set to "production" for production mode. Available options: "production", "development".

# Dashboard Theme
DASHBOARD_THEME="dark"                                       # Dashboard theme: glassmorphism | dark | light | cyberpunk | dracula | nord | emerald (default: dark).
DASHBOARD_COLOR_SCHEME="default"                             # Accent color scheme: default | cyan | purple | blue | emerald | rose | amber | indigo | crimson | teal | sunset.