# Lavalink Server Configuration
ADMIN_KEY=""                                                 # Optional host owner dashboard password (defaults to LAVA_PASS if empty)

# Internal URLs (with ports)
LAVA_INTERNAL_URL="http://localhost:2333"                    # Lavalink internal URL
DASHBOARD_INTERNAL_URL="http://localhost:2334"               # Dashboard internal URL

# Public URLs (without ports - for Cloudflare tunnels, reverse proxies, etc.)
LAVA_PUBLIC_URL=""                                           # Public Lavalink URL (e.g. https://lavalink.yourdomain.com)
DASHBOARD_PUBLIC_URL=""                                      # Public Dashboard URL (e.g. https://lavalink.yourdomain.com)

# Lavalink Auth & Security
LAVA_PASS="youshallnotpass"                                  # Lavalink authentication password
LAVA_SECURE="false"                                          # Use HTTPS for Lavalink (true/false)
LAVA_CIPHER_URL="https://cipher.kikkia.dev/"                 # Remote cipher endpoint for YouTube signature deciphering
LAVA_CIPHER_PASSWORD=""                                      # Optional password for self-hosted cipher

# YouTube OAuth
YOUTUBE_CLIENT_ID=""                                         # REQUIRED - YouTube OAuth Client ID (app type: "TVs and Limited Input devices")
YOUTUBE_CLIENT_SECRET=""                                     # YouTube OAuth Client Secret for the Client ID above
YOUTUBE_REFRESH_TOKEN=""                                     # Optional - Pre-authorized refresh token (auto-saved after device flow)

# Spotify
SPOTIFY_CLIENT_ID=""                                         # Spotify Developer App Client ID
SPOTIFY_CLIENT_SECRET=""                                     # Spotify Developer App Client Secret

# Genius (for LavaLyrics plugin)
GENIUS_ACCESS_TOKEN=""                                       # Genius API Access Token for lyrics

# Database
DB_PATH="./database.db"                                      # SQLite database file path
DB_URI="sqlite://./database.db"                              # SQLite database URI

# Environment
NODE_ENV="production"                                        # Set to "production" for production mode