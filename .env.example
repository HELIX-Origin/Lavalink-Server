# Lavalink Server Configuration
LAVA_PASS="youshallnotpass"                                                                                                   # Public connection password for Discord bots
ADMIN_KEY=""                                                                                                                  # Optional host owner dashboard password (defaults to LAVA_PASS if empty)

# YouTube & Remote Cipher
YOUTUBE_API_KEY="YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com"                                                             # REQUIRED - YouTube OAuth Client ID (app type: "TVs and Limited Input devices") used to issue the authorization URL (without it the server will not start)
YOUTUBE_REFRESH_TOKEN=""                                                                                                    # YouTube OAuth 2.0 refresh token (auto-saved to .youtube-oauth.json + SQLite after authorization)
YOUTUBE_SKIP_INIT=true                                                                                                      # Let the server-run OAuth flow issue the auth URL instead of the in-Java plugin flow
YOUTUBE_CIPHER_URL="https://cipher.kikkia.dev/"                                                                            # Remote cipher endpoint for YouTube signature deciphering
YOUTUBE_CIPHER_PASSWORD=""                                                                                                  # Optional password for self-hosted yt-cipher (leave empty for default public endpoint)

# Spotify
SPOTIFY_CLIENT_ID=""                                                                                                        # Spotify Developer App Client ID
SPOTIFY_CLIENT_SECRET=""                                                                                                    # Spotify Developer App Client Secret

# Cloud Keep-Alive & Anti-Throttling (Auto-derived from system host/domain)
KEEP_ALIVE_ENABLED=true                                                                                                     # Set to true to ping /health to prevent cloud sleep throttling
KEEP_ALIVE_INTERVAL_MS=300000                                                                                               # Ping interval in ms (default: 300000 = 5 minutes; Render sleep threshold is 15m)
